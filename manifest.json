{
  "manifest_version": 3,
  "name": "B站字幕桌面歌词 Demo",
  "version": "0.7.0",
  "description": "在置顶歌词卡中查看 B 站字幕并控制播放，仅个人本地使用。",
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://aisubtitle.hdslb.com/*"
  ],
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content/bridge.js",
        "content/desktop-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content/transport.js",
        "content/subtitle.js",
        "content/player.js",
        "content/desktop.js",
        "content/overlay.js",
        "content/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "key": ""
}
